# Variables d'environnement de BudgetFamily.
# En DÉVELOPPEMENT : copier ce fichier en `.env` (les valeurs ci-dessous suffisent).
# En PRODUCTION : définir ces variables dans le tableau de bord de l'hébergeur.
# Ne JAMAIS committer de vrai secret (le .env est ignoré par git).

ENVIRONMENT=development

# Base de données. Dev : SQLite. Prod : URL PostgreSQL de Neon (postgresql://...),
# normalisée automatiquement vers le driver psycopg 3.
DATABASE_URL=sqlite:///./budgetfamily.db

# Secrets — OBLIGATOIRES en production : l'app refuse de démarrer si elles restent
# sur ces valeurs de développement.
JWT_SECRET_KEY=dev-secret-change-me-in-production
BILLING_WEBHOOK_SECRET=dev-webhook-secret-change-me-in-production

# --- E-mails transactionnels (réinitialisation de mot de passe) ---
# Laisser vide désactive l'envoi (en dev, le jeton est alors renvoyé par l'API).
# Exemple pour Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USER=<identifiant SMTP Brevo>, SMTP_PASSWORD=<clé SMTP Brevo>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BudgetFamily
